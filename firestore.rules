rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // clientId denormalizado em todo documento — comparação direta, sem
    // get() auxiliar, tanto em leitura/update/delete (resource.data)
    // quanto em create (request.resource.data).
    function ownsExisting() {
      return isSignedIn() && resource.data.clientId == request.auth.uid;
    }

    function ownsIncoming() {
      return isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }

    // connections: apenas nome muda em update; clientId é imutável.
    match /connections/{connectionId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting()
                    && ownsIncoming()
                    && request.resource.data.clientId == resource.data.clientId;
    }

    // contacts: connectionId não é revalidado contra o dono aqui — a UI
    // só oferece as connections do próprio cliente; isolamento de
    // leitura/escrita continua garantido por clientId por documento.
    match /contacts/{contactId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting()
                    && ownsIncoming()
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.connectionId == resource.data.connectionId;
    }

    // messages: client só cria/edita/apaga; a transição para "enviada" por
    // agendamento é feita exclusivamente pela Cloud Function flipDueMessages
    // (Admin SDK, que ignora estas regras).
    match /messages/{messageId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming()
                    && request.resource.data.status in ['agendada', 'enviada'];
      allow update: if ownsExisting()
                    && ownsIncoming()
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.connectionId == resource.data.connectionId
                    // client nunca muda o status por update direto (só create
                    // decide enviada/agendada; a transição agendada->enviada é
                    // exclusiva da Cloud Function via Admin SDK)
                    && request.resource.data.status == resource.data.status;
    }

    // Nenhuma outra collection é acessível pelo client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
